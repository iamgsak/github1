# =====================================================================
# Hotel ERP — environment variables
#
# Copy to .env.local and fill in. NEVER commit a filled-in file.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser and must
# never hold a credential.
# =====================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hotel Amoha ERP"

# --- Database --------------------------------------------------------
# Pooled connection for the app; direct connection for migrations.
# Leave DATABASE_URL unset to fall back to PGHOST/PGPORT/PGUSER/PGDATABASE.
DATABASE_URL=
DIRECT_URL=

# --- Supabase (production) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ------------------------------------------------------------
AUTH_PROVIDER=local            # local | supabase
SESSION_SECRET=
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# --- Encryption ------------------------------------------------------
# 32-byte base64 key used to encrypt integration credentials and guest
# ID numbers before they reach the database. Rotate by adding a new
# version and recording its id in integration_credentials.key_id.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
# Deterministic HMAC key for searchable ID-document hashes.
ID_HASH_KEY=

# --- Payment gateways ------------------------------------------------
# Leave blank to use the mock adapter. Only fill in for a gateway the
# hotel has actually onboarded.
PAYMENT_GATEWAY=MOCK           # MOCK | RAZORPAY | CASHFREE | PAYU
PAYMENT_GATEWAY_MODE=SANDBOX   # SANDBOX | PRODUCTION
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# --- Channel manager / OTA -------------------------------------------
# Per-channel credentials are stored encrypted in the database, not
# here. These control the default mode for newly created channels.
CHANNEL_DEFAULT_MODE=MOCK      # MOCK | SANDBOX | PRODUCTION
CHANNEL_WEBHOOK_SECRET=

# --- Messaging -------------------------------------------------------
EMAIL_PROVIDER=MOCK            # MOCK | SMTP | RESEND | SENDGRID
EMAIL_FROM="Hotel Amoha <no-reply@hotelamoha.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

SMS_PROVIDER=MOCK              # MOCK | MSG91 | TWILIO | GUPSHUP
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

WHATSAPP_PROVIDER=MOCK         # MOCK | CLOUD_API | GUPSHUP
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Storage / observability -----------------------------------------
STORAGE_PROVIDER=SUPABASE
STORAGE_BUCKET=hotel-erp
SENTRY_DSN=
LOG_LEVEL=info

# --- Feature flags ---------------------------------------------------
ENABLE_BOOKING_ENGINE=true
ENABLE_CHANNEL_MANAGER=false
ENABLE_DEMO_DATA=false
